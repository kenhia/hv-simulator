# Copy to .env and adjust for your machine. Loaded by the justfile.
# .env is gitignored; this example is committed.

# Deploy target (ssh host) and published port for `just deploy` / `health` / etc.
HVSIM_HOST=kubsdb
HVSIM_PORT=4667

# Docker registry `just deploy` pushes through, and the host pulls from. The
# default is the homelab package store (k-homelab docs/deploying.md); TLS comes
# from tailscale serve, so there is nothing to log in to.
HVSIM_REGISTRY=kubsdb.encke-wahoo.ts.net:5000
